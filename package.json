{
  "name": "work-book",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Monorepo holding multiple full-stack apps; the active one is set in apps.config.json",
  "scripts": {
    "dev": "node scripts/run.mjs dev",
    "dev:client": "node scripts/run.mjs dev client",
    "dev:server": "node scripts/run.mjs dev server",
    "build": "node scripts/run.mjs build",
    "start": "node scripts/run.mjs start server",
    "lint": "node scripts/run.mjs lint client",
    "test": "node scripts/run.mjs test server",
    "install:all": "node scripts/run.mjs install",
    "apps": "node scripts/run.mjs list"
  }
}
