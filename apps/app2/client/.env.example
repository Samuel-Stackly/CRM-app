# Base URL of the ShopDesk API.
#
# Vite inlines every VITE_* value into the browser bundle at build time, so this
# must never hold a secret. The API issues an httpOnly session cookie, so there
# is no token for the client to configure or store.
#
# Local development: the server defaults to port 5001 (see apps.config.json),
# so this value works as-is after `cp .env.example .env`. It is also the
# built-in fallback, which is why the app runs without a .env file at all.
VITE_API_URL=http://localhost:5001/api
