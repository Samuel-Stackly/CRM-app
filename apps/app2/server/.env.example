# ShopDesk server configuration.
# Copy to .env and fill in real values. Never commit .env — it is gitignored.

NODE_ENV=development

# Injected by scripts/run.mjs from apps.config.json when started through the
# root scripts; this value is the fallback for a direct `npm run dev`.
PORT=5001

# Allowed browser origin(s) for CORS. Comma-separate to allow several, e.g. a
# production domain alongside a preview deployment.
CLIENT_URL=http://localhost:5174

# Accept browser requests from ANY origin, ignoring CLIENT_URL above.
#
# Defaults to true, which is convenient locally: a Vite dev server that drifts
# to another port still works. It is NOT safe for a public deployment. The auth
# cookie makes every call credentialed, so the origin is reflected rather than
# answered with `*`, and any site a signed-in admin visits can then call this
# API with their cookie and read the response. Set to false in production.
CORS_ALLOW_ALL=true

# --- Required ---------------------------------------------------------------
# The server refuses to start without both of these. There is no fallback
# secret and no default connection string anywhere in the codebase.

# MongoDB connection string. Contains credentials — keep it out of git and out
# of logs. Replace every <placeholder> below with your own values.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/shopdesk?retryWrites=true&w=majority

# Signing secret for the auth JWT. Minimum 16 characters. Generate a fresh
# random value per environment and never reuse the development one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<generate-a-random-48-byte-value>

# Token lifetime, as an ms-style duration (7d, 12h, 30m, 60s).
JWT_EXPIRES_IN=7d
