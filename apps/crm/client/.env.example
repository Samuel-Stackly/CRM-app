# Base URL for the API. Public by design — Vite inlines VITE_* values into the
# browser bundle, so never put a secret behind this prefix.
#
# Production (recommended): a relative path, so requests go to the frontend's
# own origin and Vercel proxies them to the backend via the rewrite in
# vercel.json. The auth cookie is then first-party, which is required because
# Chrome and Safari block third-party cookies.
#   VITE_API_URL=/api
#
# Direct cross-origin to the backend. Works only while the browser still allows
# third-party cookies, so it is not suitable for production.
#   VITE_API_URL=https://<your-backend>.onrender.com/api

VITE_API_URL=http://localhost:5000/api
